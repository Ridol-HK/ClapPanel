<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Authors>Ridol-HK</Authors>
    <Version>1.5.0</Version>
    <Copyright>Copyright (C) 2026 Ridol-HK</Copyright>
    <RepositoryUrl>https://github.com/Ridol-HK/ClapPanel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Ridol-HK/ClapPanel</PackageProjectUrl>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ClapPanel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
