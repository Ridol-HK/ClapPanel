<Window Style="{StaticResource {x:Type Window}}"
        x:Class="ClapPanel.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClapPanel.Localization"
        xmlns:local="clr-namespace:ClapPanel.Views"
        Title="ClapPanel"
        SizeToContent="WidthAndHeight"
        MinWidth="150"
        MinHeight="140"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        DragOver="Panel_DragOver"
        Drop="Panel_Drop"
        PreviewKeyDown="PanelWindow_PreviewKeyDown"
        PreviewTextInput="PanelWindow_PreviewTextInput"
        KeyDown="PanelWindow_KeyDown">
    <Window.Resources>
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TileBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding TileRadius, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileRoot" Property="Background" Value="{DynamicResource TileHoverBrush}" />
                                <Setter TargetName="TileRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TileRoot" Property="Background" Value="{DynamicResource TileHoverBrush}" />
                                <Setter TargetName="TileRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="TileRoot" Property="BorderThickness" Value="3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileRoot" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionRoot" Background="{TemplateBinding Background}" CornerRadius="6" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ActionScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionRoot" Property="Background" Value="{DynamicResource TileHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionRoot" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActionScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="ActionScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActionScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="ActionScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="PanelRoot" Background="Transparent">
    <Border x:Name="PanelBorder"
            Margin="6"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="{Binding PanelRadius, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="PanelTranslate" X="0" Y="0" />
            </TransformGroup>
        </Border.RenderTransform>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="MoveHandle"
                        Grid.Column="0"
                        Background="Transparent"
                        CornerRadius="6"
                        Padding="6,3"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="MoveHandle_MouseLeftButtonDown">
                    <TextBlock x:Name="PanelTitleText"
                               Text="ClapPanel"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Border>
                <Button x:Name="SettingsButton"
                        AutomationProperties.Name="{loc:Tr Panel.Customize}"
                        Grid.Column="1"
                        Content="⋯"
                        HorizontalAlignment="Right"
                        Style="{StaticResource PanelActionButtonStyle}"
                        ToolTip="{loc:Tr Panel.Customize}"
                        Click="Settings_Click" />
                <Button x:Name="ClosePanelButton"
                        AutomationProperties.Name="{loc:Tr Panel.CloseTip}"
                        Grid.Column="2"
                        Content="×"
                        HorizontalAlignment="Right"
                        Style="{StaticResource PanelActionButtonStyle}"
                        ToolTip="{loc:Tr Panel.CloseTip}"
                        Click="ClosePanel_Click" />
            </Grid>

            <StackPanel x:Name="ToolbarPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,7">
                <StackPanel x:Name="ToolbarButtons" Orientation="Horizontal">
                    <Button x:Name="BackButton"
                        AutomationProperties.Name="{loc:Tr Panel.BackTip}"
                            Content="‹"
                            Width="28"
                            Height="27"
                            Margin="0,0,5,0"
                            Visibility="Collapsed"
                            ToolTip="{loc:Tr Panel.BackTip}"
                            Style="{StaticResource PanelActionButtonStyle}"
                            Click="Back_Click" />
                    <ToggleButton x:Name="FavoritesButton"
                        AutomationProperties.Name="{loc:Tr Panel.FavoritesTip}"
                                  Content="★"
                                  Width="28"
                                  Height="27"
                                  Padding="0"
                                  Margin="0,0,5,0"
                                  ToolTip="{loc:Tr Panel.FavoritesTip}"
                                  Foreground="{DynamicResource AccentBrush}"
                                  Checked="Favorites_Click"
                                  Unchecked="Favorites_Click" />
                </StackPanel>
                <TextBox x:Name="SearchBox"
                        AutomationProperties.Name="{loc:Tr Panel.SearchTip}"
                         Width="145"
                         MinWidth="80"
                         Height="27"
                         VerticalContentAlignment="Center"
                         Padding="6,2"
                         Margin="0,0,5,0"
                         ToolTip="{loc:Tr Panel.SearchTip}"
                         TextChanged="Search_TextChanged" />
                <ComboBox x:Name="CategoryCombo"
                        AutomationProperties.Name="{loc:Tr Panel.CategoryTip}"
                          Width="105"
                          Height="27"
                          VerticalContentAlignment="Center"
                          ToolTip="{loc:Tr Panel.CategoryTip}"
                          SelectionChanged="Category_Changed">
                    <ComboBoxItem Content="{loc:Tr Panel.AllCategories}" />
                </ComboBox>
            </StackPanel>

            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <local:WidgetsView x:Name="WidgetsHost" />
                    <ItemsControl x:Name="Tiles">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="{Binding TileSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        Height="{Binding TileSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        Margin="4"
                                        Style="{StaticResource TileButtonStyle}"
                                        BorderThickness="{Binding TileBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        AutomationProperties.Name="{Binding AutomationName}"
                                        AutomationProperties.HelpText="{Binding ToolTipText}"
                                        AllowDrop="True"
                                        ToolTip="{Binding ToolTipText}"
                                        Click="Tile_Click"
                                        PreviewMouseLeftButtonDown="Tile_MouseDown"
                                        PreviewMouseMove="Tile_MouseMove"
                                        DragOver="Panel_DragOver"
                                        Drop="Tile_Drop">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{loc:Tr Panel.ContextEdit}" Click="ContextEdit_Click" />
                                            <MenuItem Header="{loc:Tr Panel.ContextDuplicate}" Click="ContextDuplicate_Click" />
                                            <Separator />
                                            <MenuItem Header="{loc:Tr Panel.ContextOpenLocation}" Click="ContextOpenLocation_Click" />
                                            <MenuItem Header="{loc:Tr Panel.ContextDelete}" Click="ContextDelete_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Image Source="{Binding Icon}"
                                                   Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                            <TextBlock Text="{Binding Item.Name}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       MaxWidth="{Binding NameWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                       Visibility="{Binding NameVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                       Margin="0,6,0,0"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ShortcutBadge}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   Margin="5,3,0,0" />
                                        <TextBlock Text="★"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   Margin="0,2,4,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="!"
                                                   Foreground="#FFB74D"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,2,4,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Missing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText"
                           Text="{loc:Tr Panel.Empty}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>

    <!-- Invisible resize handles: the cursor changes when the user approaches an edge or corner. -->
    <Thumb x:Name="LeftResizeThumb" Style="{StaticResource ResizeThumbStyle}" Tag="Left" Width="8" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,14"
           Background="Transparent" Cursor="SizeWE" ToolTip="{loc:Tr Panel.ResizeTip}"
           DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
    <Thumb x:Name="RightResizeThumb" Style="{StaticResource ResizeThumbStyle}" Tag="Right" Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,14"
           Background="Transparent" Cursor="SizeWE" ToolTip="{loc:Tr Panel.ResizeTip}"
           DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
    <Thumb x:Name="TopResizeThumb" Style="{StaticResource ResizeThumbStyle}" Tag="Top" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="14,0"
           Background="Transparent" Cursor="SizeNS" ToolTip="{loc:Tr Panel.ResizeTip}"
           DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
    <Thumb x:Name="BottomResizeThumb" Style="{StaticResource ResizeThumbStyle}" Tag="Bottom" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="14,0"
           Background="Transparent" Cursor="SizeNS" ToolTip="{loc:Tr Panel.ResizeTip}"
           DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
    <Thumb x:Name="TopLeftResizeThumb" Style="{StaticResource ResizeThumbStyle}" Tag="TopLeft" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top"
           Background="Transparent" Cursor="SizeNWSE" ToolTip="{loc:Tr Panel.ResizeTip}"
           DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
    <Thumb x:Name="TopRightResizeThumb" Style="{StaticResource ResizeThumbStyle}" Tag="TopRight" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
           Background="Transparent" Cursor="SizeNESW" ToolTip="{loc:Tr Panel.ResizeTip}"
           DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
    <Thumb x:Name="BottomLeftResizeThumb" Style="{StaticResource ResizeThumbStyle}" Tag="BottomLeft" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom"
           Background="Transparent" Cursor="SizeNESW" ToolTip="{loc:Tr Panel.ResizeTip}"
           DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
    <Thumb x:Name="BottomRightResizeThumb" Style="{StaticResource ResizeThumbStyle}" Tag="BottomRight" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
           Background="Transparent" Cursor="SizeNWSE" ToolTip="{loc:Tr Panel.ResizeTip}"
           DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted" />
    </Grid>
</Window>
