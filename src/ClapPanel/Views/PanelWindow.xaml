<Window x:Class="ClapPanel.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClapPanel"
        SizeToContent="WidthAndHeight"
        MinWidth="240"
        MinHeight="120"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="#1E1E1E">
    <Grid Margin="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Tiles">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="96"
                                Height="96"
                                Margin="4"
                                Background="#2D2D30"
                                BorderBrush="#3F3F46"
                                Foreground="White"
                                AllowDrop="True"
                                ToolTip="{Binding Item.Target}"
                                Click="Tile_Click"
                                PreviewMouseLeftButtonDown="Tile_MouseDown"
                                PreviewMouseMove="Tile_MouseMove"
                                Drop="Tile_Drop">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="40" Height="40" />
                                    <TextBlock Text="{Binding Item.Name}"
                                               Foreground="White"
                                               MaxWidth="84"
                                               Margin="0,6,0,0"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="!"
                                           Foreground="#FFB74D"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           Margin="0,2,4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Missing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="EmptyText"
                   Text="Sin iconos. Añádelos desde Ajustes."
                   Foreground="#9E9E9E"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed" />
    </Grid>
</Window>
