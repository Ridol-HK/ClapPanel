<Window Style="{StaticResource {x:Type Window}}"
        x:Class="ClapPanel.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClapPanel.Localization"
        Title="{loc:Tr About.Title}"
        Width="520"
        Height="640"
        MinWidth="440"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{loc:Tr Common.Close}" IsCancel="True" IsDefault="True" Padding="18,6" Click="Close_Click" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="ClapPanel" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText"
                           Foreground="{DynamicResource AccentBrush}"
                           FontWeight="SemiBold"
                           Margin="0,2,0,6" />
                <TextBlock Text="{loc:Tr About.Tagline}" TextWrapping="Wrap" Margin="0,0,0,4" />
                <TextBlock x:Name="CopyrightText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,18" />

                <TextBlock Text="{loc:Tr About.License}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="GNU General Public License v3.0 or later (GPL-3.0-or-later)"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />
                <TextBlock Text="{loc:Tr About.LicenseText}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Button Content="{loc:Tr About.Repository}" Padding="12,5" Margin="0,0,8,0" Click="Repository_Click" />
                    <Button Content="{loc:Tr About.FullLicense}" Padding="12,5" Click="License_Click" />
                </StackPanel>

                <TextBlock Text="{loc:Tr About.Credits}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="{loc:Tr About.CreditsHint}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <ItemsControl x:Name="CreditsList" Margin="0,0,0,18">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <Button Content="{Binding Name}"
                                        Tag="{Binding Url}"
                                        HorizontalAlignment="Left"
                                        Padding="10,3"
                                        Click="Credit_Click" />
                                <TextBlock Text="{Binding License}"
                                           FontWeight="SemiBold"
                                           Margin="2,4,0,0" />
                                <TextBlock Text="{Binding Description}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="2,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{loc:Tr About.Privacy}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="{loc:Tr About.PrivacyText}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
