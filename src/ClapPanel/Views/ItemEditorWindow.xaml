<Window Style="{StaticResource {x:Type Window}}"
        x:Class="ClapPanel.Views.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso directo"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <CheckBox x:Name="FolderCheck" Content="Es una carpeta desplegable de ClapPanel" Margin="0,0,0,14" Checked="FolderType_Changed" Unchecked="FolderType_Changed" />

        <TextBlock Text="Nombre" />
        <TextBox x:Name="NameBox" Margin="0,6,0,16" />

        <StackPanel x:Name="TargetPanel">
            <TextBlock Text="Destino" />
            <DockPanel Margin="0,6,0,16">
                <Button DockPanel.Dock="Right" Content="Archivo" Padding="10,2" Margin="8,0,0,0" Click="BrowseTarget_Click" />
                <Button DockPanel.Dock="Right" Content="Carpeta" Padding="10,2" Margin="8,0,0,0" Click="BrowseFolder_Click" />
                <TextBox x:Name="TargetBox" TextChanged="Target_TextChanged" />
            </DockPanel>
        </StackPanel>

        <StackPanel x:Name="ArgumentsPanel">
            <TextBlock Text="Argumentos (opcional)" />
            <TextBox x:Name="ArgumentsBox" Margin="0,6,0,16" />
        </StackPanel>

        <TextBlock Text="Categoría (opcional; por ejemplo Juegos, Trabajo o Multimedia)" TextWrapping="Wrap" />
        <TextBox x:Name="CategoryBox" Margin="0,6,0,10" />
        <CheckBox x:Name="FavoriteCheck" Content="Marcar como favorito" Margin="0,0,0,16" />

        <TextBlock Text="Imagen personalizada (opcional)" />
        <DockPanel Margin="0,6,0,20">
            <Image x:Name="PreviewImage" DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,12,0" />
            <StackPanel>
                <TextBox x:Name="ImageBox" IsReadOnly="True" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Elegir imagen" Style="{StaticResource AccentButtonStyle}" Padding="10,2" Click="BrowseImage_Click" />
                    <Button Content="Quitar" Style="{StaticResource DangerButtonStyle}" Padding="10,2" Margin="8,0,0,0" Click="ClearImage_Click" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True" Padding="20,6" Margin="0,0,8,0" />
            <Button Content="Aceptar" Style="{StaticResource AccentButtonStyle}" IsDefault="True" Padding="20,6" Click="Accept_Click" />
        </StackPanel>
    </StackPanel>
</Window>
