<Window x:Class="ClapPanel.Views.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Icono"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Nombre" />
        <TextBox x:Name="NameBox" Margin="0,6,0,16" />

        <TextBlock Text="Destino" />
        <DockPanel Margin="0,6,0,16">
            <Button DockPanel.Dock="Right"
                    Content="Examinar"
                    Padding="10,2"
                    Margin="8,0,0,0"
                    Click="BrowseTarget_Click" />
            <TextBox x:Name="TargetBox" TextChanged="Target_TextChanged" />
        </DockPanel>

        <TextBlock Text="Argumentos (opcional)" />
        <TextBox x:Name="ArgumentsBox" Margin="0,6,0,16" />

        <TextBlock Text="Imagen" />
        <DockPanel Margin="0,6,0,20">
            <Image x:Name="PreviewImage"
                   DockPanel.Dock="Left"
                   Width="48"
                   Height="48"
                   Margin="0,0,12,0" />
            <StackPanel>
                <TextBox x:Name="ImageBox" IsReadOnly="True" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Elegir imagen" Padding="10,2" Click="BrowseImage_Click" />
                    <Button Content="Quitar" Padding="10,2" Margin="8,0,0,0" Click="ClearImage_Click" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True" Padding="20,6" Margin="0,0,8,0" />
            <Button Content="Aceptar" IsDefault="True" Padding="20,6" Click="Accept_Click" />
        </StackPanel>
    </StackPanel>
</Window>
