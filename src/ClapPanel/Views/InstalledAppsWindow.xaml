<Window Style="{StaticResource {x:Type Window}}"
        x:Class="ClapPanel.Views.InstalledAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClapPanel.Localization"
        Title="{loc:Tr Picker.Title}"
        Width="480"
        Height="560"
        MinWidth="380"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{loc:Tr Picker.Hint}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" />
            <TextBox x:Name="SearchBox"
                     Margin="0,10,0,0"
                     ToolTip="{loc:Tr Picker.Search}"
                     AutomationProperties.Name="{loc:Tr Picker.Search}"
                     TextChanged="Search_TextChanged" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0" />
            <Button Content="{loc:Tr Common.Cancel}" IsCancel="True" Padding="18,6" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="SelectButton"
                    Content="{loc:Tr Picker.Select}"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="18,6"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="Select_Click" />
        </StackPanel>
        <ListBox x:Name="AppsList"
                 AutomationProperties.Name="{loc:Tr Picker.Title}"
                 MouseDoubleClick="AppsList_DoubleClick"
                 SelectionChanged="AppsList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Image Source="{Binding Icon}"
                               Width="24"
                               Height="24"
                               Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
