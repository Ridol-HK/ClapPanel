<Window x:Class="ClapPanel.Views.ProfileSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClapPanel.Localization"
        Style="{StaticResource {x:Type Window}}"
        Title="{loc:Tr Profile.Title}"
        Width="620"
        Height="520"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="ProfileCardButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource WindowSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="MinHeight" Value="104" />
            <Setter Property="MaxWidth" Value="280" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource WindowNavigationBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{loc:Tr Profile.Heading}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="{loc:Tr Profile.Subtitle}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ProfilesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ProfileCardButtonStyle}"
                                Click="ChooseProfile_Click"
                                ToolTip="{loc:Tr Profile.UseTip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{Binding AccentBrush}"
                                        CornerRadius="3"
                                        Margin="0,2,0,2" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="{loc:Tr Profile.Use}"
                                               Margin="0,10,0,0"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource WindowNavigationBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10"
                Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{loc:Tr Profile.Footer}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="350"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Button DockPanel.Dock="Right"
                        Content="{loc:Tr Profile.Continue}"
                        IsCancel="True"
                        Padding="14,7"
                        Margin="12,0,0,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
