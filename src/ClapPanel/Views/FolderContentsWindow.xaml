<Window Style="{StaticResource {x:Type Window}}"
        x:Class="ClapPanel.Views.FolderContentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClapPanel.Localization"
        Title="{loc:Tr Folder.Title}"
        Width="620"
        Height="440"
        MinWidth="500"
        MinHeight="340"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="FolderTitle" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Tr Folder.Hint}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Tr Common.Close}" IsCancel="True" Padding="18,6" Click="Close_Click" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ItemsList" Grid.Column="0" AutomationProperties.HelpText="{loc:Tr Settings.DragSortTip}" ToolTip="{loc:Tr Settings.DragSortTip}" DisplayMemberPath="DisplayLabel" MouseDoubleClick="OpenFolder_Click" />
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <Button Content="{loc:Tr Settings.AddApp}" Style="{StaticResource AccentButtonStyle}" Width="120" Margin="0,0,0,5" Click="AddApplication_Click" />
                <Button Content="{loc:Tr Settings.AddFolder}" Style="{StaticResource AccentButtonStyle}" Width="120" Margin="0,0,0,5" Click="AddFolder_Click" />
                <Button Content="{loc:Tr Common.Edit}" Width="120" Margin="0,0,0,5" Click="Edit_Click" />
                <Button Content="{loc:Tr Folder.OpenFolder}" Width="120" Margin="0,0,0,5" Click="OpenFolder_Click" />
                <Button Content="{loc:Tr Common.Remove}" Style="{StaticResource DangerButtonStyle}" Width="120" Margin="0,0,0,5" Click="Remove_Click" />
                <Button Content="{loc:Tr Common.MoveUp}" Width="120" Margin="0,0,0,5" Click="MoveUp_Click" />
                <Button Content="{loc:Tr Common.MoveDown}" Width="120" Click="MoveDown_Click" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
