<Window x:Class="ClapPanel.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes"
        Width="440"
        SizeToContent="Height"
        MaxHeight="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Micrófono" />
            <ComboBox x:Name="DeviceCombo"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      Margin="0,6,0,16" />

            <TextBlock Text="Sensibilidad" />
            <Slider x:Name="SensitivitySlider"
                    Minimum="0"
                    Maximum="100"
                    Margin="0,6,0,16" />

            <TextBlock Text="Nivel de entrada (la marca roja es el umbral de detección)"
                       TextWrapping="Wrap" />
            <Grid Margin="0,6,0,16">
                <ProgressBar x:Name="LevelBar"
                             Minimum="0"
                             Maximum="1"
                             Height="12" />
                <Rectangle Width="2"
                           Height="12"
                           Fill="Red"
                           HorizontalAlignment="Center" />
            </Grid>

            <CheckBox x:Name="StartupCheck"
                      Content="Iniciar con Windows"
                      Margin="0,0,0,16" />

            <TextBlock Text="Columnas del panel" />
            <DockPanel Margin="0,6,0,16">
                <TextBlock DockPanel.Dock="Right"
                           Width="24"
                           TextAlignment="Right"
                           Text="{Binding Value, ElementName=ColumnsSlider}" />
                <Slider x:Name="ColumnsSlider"
                        Minimum="1"
                        Maximum="10"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True" />
            </DockPanel>

            <TextBlock Text="Iconos del panel" />
            <Grid Height="170" Margin="0,6,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="ItemsList"
                         DisplayMemberPath="Name"
                         MouseDoubleClick="Edit_Click" />
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Button Content="Añadir" Width="80" Margin="0,0,0,4" Click="Add_Click" />
                    <Button Content="Editar" Width="80" Margin="0,0,0,4" Click="Edit_Click" />
                    <Button Content="Eliminar" Width="80" Margin="0,0,0,4" Click="Remove_Click" />
                    <Button Content="Subir" Width="80" Margin="0,0,0,4" Click="MoveUp_Click" />
                    <Button Content="Bajar" Width="80" Click="MoveDown_Click" />
                </StackPanel>
            </Grid>

            <Button Content="Guardar"
                    Padding="20,6"
                    HorizontalAlignment="Right"
                    Click="Save_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
