<Window Style="{StaticResource {x:Type Window}}"
        x:Class="ClapPanel.Views.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibrar micrófono"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />
        <TextBlock x:Name="BodyText"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
            <TextBlock Text="Tiempo" Margin="0,0,0,4" />
            <ProgressBar x:Name="TimeBar"
                         Minimum="0"
                         Maximum="1"
                         Height="8"
                         Margin="0,0,0,12" />
            <TextBlock Text="Nivel del micrófono" Margin="0,0,0,4" />
            <ProgressBar x:Name="LevelBar"
                         Minimum="0"
                         Maximum="1"
                         Height="8" />
        </StackPanel>

        <TextBlock x:Name="ResultText"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Cancelar" Padding="16,6" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="SecondaryButton"
                    Content="Repetir"
                    Padding="16,6"
                    Margin="0,0,8,0"
                    Visibility="Collapsed"
                    Click="Secondary_Click" />
            <Button x:Name="PrimaryButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="Empezar"
                    Padding="16,6"
                    Click="Primary_Click" />
        </StackPanel>
    </StackPanel>
</Window>
